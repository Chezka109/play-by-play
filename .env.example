# HTTP server
PORT=3001
SERVE_CLIENT=false
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# ESPN scoreboard and play feed
ESPN_SCOREBOARD_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard
ESPN_SUMMARY_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/summary?event=
PROVIDER_TIMEOUT_MS=8000
SCHEDULE_CACHE_MS=20000
POLL_INTERVAL_MS=5000
DEFAULT_EVENT_ID=

# Field Guide explanation agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_TOOL_ROUNDS=2
EXPLAIN_ON_INGEST=true
EXPLAIN_RATE_LIMIT_MAX=30
EXPLAIN_RATE_LIMIT_WINDOW_MS=60000
