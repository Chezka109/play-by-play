# Server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ESPN
DEFAULT_EVENT_ID=
POLL_INTERVAL_MS=8000
ESPN_SUMMARY_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/football/nfl/summary?event=

# OpenAI (optional in dev; if not set, server uses a deterministic fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EXPLAIN_ON_INGEST=true
